# Contact address embedded in the User-Agent on every upstream request.
AG_CONTACT=you@example.com

# HTTP port for the API + dashboard
PORT=8080

# Storage: "sqlite" (default, zero-install) or "postgres"
STORE=sqlite
SQLITE_PATH=./data/tracker.db
# DATABASE_URL=postgres://localhost:5432/ag2026   # required when STORE=postgres

# Redis pub/sub for SSE fan-out. Omit to use the in-process bus (single node only).
REDIS_URL=redis://127.0.0.1:6379

# Country to track
COUNTRY=IND

# Set to 1 to poll only; set to 0 to disable the poller and serve stored data
POLLER_ENABLED=1

# Community discussion panel (embed.reddit.com). REDDIT_ENABLED=0 removes it.
REDDIT_ENABLED=1
REDDIT_SUBREDDIT=IndianSports
# Auto-discovers the newest daily megathread. Pin one instead with:
# REDDIT_THREAD_URL=https://www.reddit.com/r/IndianSports/comments/1wkl7il/india_at_aichi_nagoya_asian_games_2026_day_1/
